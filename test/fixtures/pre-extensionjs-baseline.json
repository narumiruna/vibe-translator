	"manifest": {
		"manifest_version": 3,
		"name": "Vibe Translator",
		"version": "0.1.3",
		"description": "Translate web pages with an OpenAI-compatible API while keeping the original text visible.",
		"permissions": ["activeTab", "contextMenus", "scripting", "storage"],
		"host_permissions": [
			"https://youtube.com/*",
			"https://www.youtube.com/*",
			"https://m.youtube.com/*"
		],
		"optional_host_permissions": ["http://*/*", "https://*/*"],
		"action": {
			"default_title": "Translate this page",
			"default_icon": {
				"16": "icons/icon-16.png",
				"32": "icons/icon-32.png",
				"48": "icons/icon-48.png",
				"128": "icons/icon-128.png"
			}
		},
		"content_scripts": [
			{
				"matches": [
					"https://youtube.com/*",
					"https://www.youtube.com/*",
					"https://m.youtube.com/*"
				],
				"run_at": "document_idle"
			}
		]
	}
